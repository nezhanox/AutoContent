APP_NAME="AI Content Factory"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://autocontent.loc:8090

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=autocontent
DB_USERNAME=autocontent
DB_PASSWORD=autocontent

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
QUEUE_CONNECTION=redis
CACHE_STORE=redis

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# --- AI providers (TechnicalTask.md §18) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# Global-default level of the LLM priority chain (TechnicalTask.md §6.2)
LLM_DEFAULT_PROVIDER=openai
LLM_DEFAULT_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
DEEPSEEK_BASE_URL=https://api.deepseek.com

ELEVENLABS_API_KEY=
ELEVENLABS_BASE_URL=https://api.elevenlabs.io/v1
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_DEFAULT_VOICE=

WHISPER_PYTHON_BINARY=python3
WHISPER_MODEL=base
WHISPER_TIMEOUT=600

FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe

PIXABAY_API_KEY=
PIXABAY_BASE_URL=https://pixabay.com/api

PEXELS_API_KEY=
PEXELS_BASE_URL=https://api.pexels.com

RENDER_TIMEOUT=180
RENDER_WIDTH=1080
RENDER_HEIGHT=1920
RENDER_FPS=30
RENDER_SUBTITLE_FONT="Oswald"
RENDER_SUBTITLE_FONT_SIZE=64
RENDER_SUBTITLE_POSITION=middle
RENDER_SUBTITLE_MARGIN_V=120
RENDER_SUBTITLE_MARGIN_H=60
RENDER_SUBTITLE_COLOR="&H00FFFFFF"
RENDER_SUBTITLE_OUTLINE_COLOR="&H00000000"
RENDER_VOICE_VOLUME=1.0
RENDER_MUSIC_VOLUME=0.15
RENDER_TRANSITION_TYPE=fade
RENDER_TRANSITION_DURATION=0.5
RENDER_QUALITY_DURATION_TOLERANCE=2.0

# Must stay above the longest job $timeout (DownloadSourceVideoJob/TranscribeSourceVideoJob = 3700).
REDIS_QUEUE_RETRY_AFTER=3900

# --- YouTube channel clips (config/clips.php) ---
CLIPS_POLL_INTERVAL_MINUTES=30
CLIPS_DISCOVER_LIMIT=5
CLIPS_WINDOW_MINUTES=90
CLIPS_WINDOW_OVERLAP_SECONDS=60
CLIPS_UTTERANCE_MAX_SECONDS=15
CLIPS_UTTERANCE_PAUSE_SECONDS=0.7
CLIPS_PADDING_SECONDS=0.15
CLIPS_SUBTITLE_MAX_WORDS=6
CLIPS_SUBTITLE_FONT="Poppins ExtraBold"
CLIPS_SUBTITLE_FONT_SIZE=76
CLIPS_SUBTITLE_MARGIN_V=500
CLIPS_SUBTITLE_MARGIN_H=90
CLIPS_SUBTITLE_OUTLINE_WIDTH=4
CLIPS_SUBTITLE_SHADOW_WIDTH=2
CLIPS_MAX_OUTPUT_TOKENS=8192
YT_DLP_BINARY=yt-dlp
YT_DLP_FORMAT="bv*[height<=1080]+ba/b[height<=1080]"
# YT_DLP_COOKIES_FILE=/path/to/cookies.txt
YT_DLP_TIMEOUT=3600
YT_DLP_LIST_TIMEOUT=120

# --- S3-compatible storage (TechnicalTask.md §17-18) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
FILESYSTEM_DISK=local
